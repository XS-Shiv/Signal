# Supabase project "signal" (ap-south-1)
SUPABASE_URL=https://kmpkckqkkneaeingyxho.supabase.co

# Secret. Supabase dashboard -> Project Settings -> API Keys -> service_role.
# Server-only: it is never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# OPTIONAL. Leave this unset and the site is open to anyone with the link.
# Set it to a short spoken phrase ("open the workshop") and every visit has to
# say it, with typing as a fallback. Words work far better than digits.
# This is a spoken password, not a voiceprint: it checks WHAT is said, not WHO
# said it, so anyone who overhears the phrase can get in.
SIGNAL_VOICE_PHRASE=
